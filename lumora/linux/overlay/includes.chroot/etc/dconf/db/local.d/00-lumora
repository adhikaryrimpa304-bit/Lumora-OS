[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='Adwaita-dark'
icon-theme='Papirus-Dark'
accent-color='purple'
font-name='Inter 11'
document-font-name='Inter 11'
show-battery-percentage=true
clock-show-weekday=true
clock-format='24h'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/lumora/lumora.png'
picture-uri-dark='file:///usr/share/backgrounds/lumora/lumora.png'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/lumora/lumora.png'

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'

[org/gnome/mutter]
edge-tiling=true
dynamic-workspaces=true

[org/gnome/shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com','blur-my-shell@aunetx','caffeine@patapon.info','lumora-clock@lumora']
favorite-apps=['org.gnome.Nautilus.desktop','firefox-esr.desktop','org.gnome.Terminal.desktop','org.gnome.Settings.desktop']

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
dash-max-icon-size=46
extend-height=false
transparency-mode='FIXED'
custom-background-color=true
background-color='#1C1230'
background-opacity=0.55
intellihide-mode='ALL_WINDOWS'
show-trash=false
show-mounts=false
click-action='minimize-or-previews'
running-indicator-style='DOTS'
custom-theme-customize-running-dots=true
custom-theme-running-dots-color='#00F0FF'
